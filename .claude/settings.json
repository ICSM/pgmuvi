{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git branch)",
      "Bash(git fetch *)",
      "Bash(git fetch)",
      "Bash(git blame *)",
      "Bash(git check-ignore *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh project list *)",
      "Bash(gh project item-list *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(cat *)",
      "Bash(diff *)",
      "Bash(ruff check *)",
      "Bash(ruff format --check *)",
      "Bash(ruff format --diff *)",
      "Bash(python -m unittest *)",
      "Bash(python3 -m unittest *)",
      "Bash(.venv/bin/python -m unittest *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(.venv/bin/python -m pytest *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)"
    ]
  }
}
